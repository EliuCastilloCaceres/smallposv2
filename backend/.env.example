# .env.example — copia esto a .env y rellena los valores

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# JWT — genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Servidor
SERVER_PORT=3001
NODE_ENV=development   # cambiar a 'production' en el hosting

#timezone offset
APP_UTC_OFFSET ='-06:00'

# CORS — en producción pon la URL exacta del frontend
#CORS_ORIGIN=http://127.0.0.1:5173